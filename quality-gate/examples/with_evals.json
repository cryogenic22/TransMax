{
  "packs": ["core", "python", "security", "extras"],
  "prs": { "enabled": true, "min_score": 85 },
  "thresholds": { "error_count": 0 },
  "evals": {
    "enabled": true,
    "datasets_path": "eval_datasets/golden",
    "baseline_path": "eval_datasets/regression/baseline.json",
    "coverage": { "allow_empty": false },
    "thresholds": {
      "min_accuracy": 0.9,
      "regression_tolerance": 0.02,
      "max_latency_p99_ms": 1000
    },
    "pythonpath": [],
    "executor": {
      "type": "python_callable",
      "callable": "your_package.your_adapter:run_case",
      "timeout_ms": 10000
    }
  }
}
