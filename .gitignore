# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment variables
.env
.env.local

# Databases
*.db

# Uploads (user-generated content)
uploads/

# Logs and debug output
*.log
*.txt
!requirements.txt
!requirements-export.txt
!README.txt

# Claude Code transient session state (commands/skills may be shared; these are not)
.claude/worktrees/
.claude/scheduled_tasks.lock

# Testing
.pytest_cache/
.coverage
htmlcov/

# Linting / Formatting
.ruff_cache/
.mypy_cache/

# Node / Frontend (handled by frontend/.gitignore)
node_modules/
.next/

# Regulatory Pack per-release output (TMX-3500); keep .gitkeep
regulatory_pack/releases/*
!regulatory_pack/releases/.gitkeep
.env.*
*.pyc
